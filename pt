#!/usr/bin/env bash
# pt — PT Agent 启动器（宿主机侧）
#   pt                进入当前交战容器（无则新建）
#   pt init           配置模型与密钥 + 连通性自检
#   pt doctor         八项自检
#   pt update         更新镜像与身份包
#   pt down           停止并删除交战容器（保留工作区）
#   pt clean          删除工作区（二次确认）；--purge 连容器一起
#   pt capture on|off mitmproxy 流量存档开关
#   pt install <pkg>  在工作区工具箱安装工具（随工作区走）
#   pt snapshot <tag> 把当前容器提交为派生镜像
#   pt selftest       靶场冒烟 + 评分（M3）
#   pt export-learnings  脱敏导出本地经验
#   pt fix-perms      把工作区属主改回当前用户
#   pt help

set -euo pipefail

PT_HOME="${PT_HOME:-$HOME/.pentest-agent}"
CONFIG="$PT_HOME/config.env"
[ -f "$CONFIG" ] || { echo "未找到 $CONFIG —— 先运行 installer/install.sh" >&2; exit 1; }
set -a; . "$CONFIG"; set +a

IMAGE="${PT_IMAGE:-${PT_IMAGE_REGISTRY:-ghcr.io/xxxe88}/pt-agent:${PT_IMAGE_TAG:-v0.1.0}}"   # 发布 tag 为 v0.1.0（另有 latest）
WS_ROOT="$PT_HOME/workspaces"
PI_HOME="$PT_HOME/pi-home"
NETWORK="${PT_NETWORK:-host}"
CAPS="${PT_CAPS:-NET_RAW,NET_ADMIN}"
MEM="${PT_MEM:-4g}"
CPUS="${PT_CPUS:-2}"
PIDS="${PT_PIDS_LIMIT:-2048}"

C_B="\033[36m"; C_G="\033[32m"; C_Y="\033[33m"; C_R="\033[31m"; C_0="\033[0m"
log(){ printf "${C_B}[pt]${C_0} %s\n" "$*"; }
ok(){ printf "${C_G}[ok]${C_0} %s\n" "$*"; }
warn(){ printf "${C_Y}[!]${C_0} %s\n" "$*"; }
die(){ printf "${C_R}[x]${C_0} %s\n" "$*" >&2; exit 1; }

need_docker(){ command -v docker >/dev/null || die "缺少 docker"; docker info >/dev/null 2>&1 || die "docker daemon 不可用"; }
slug(){ printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-\+/-/g; s/^-//; s/-$//' | cut -c1-40; }

# 确保 pi 能解析到模型：config.env 已有网关 URL+KEY 但 models.json 缺失/未含 provider 时自动同步
# （否则用户装完直接 pt 会看到 "Model xxx not found"）
ensure_models_json(){
  [ -n "${PT_BASE_URL:-}" ] && [ -n "${PT_API_KEY:-}" ] || return 0
  local mj="$PI_HOME/models.json"
  if [ -s "$mj" ] && python3 - "$mj" <<'PYX' 2>/dev/null; then
import json,sys
d=json.load(open(sys.argv[1])); p=d.get("providers",{}).get("gateway",{})
ok = bool(p.get("models")) and p.get("api") == "openai-completions" and bool(p.get("baseUrl"))
sys.exit(0 if ok else 1)
PYX
    return 0
  fi
  docker image inspect "$IMAGE" >/dev/null 2>&1 || return 0
  log "生成模型清单（pi 的 models.json）"
  sync_gateway_models || warn "模型清单同步失败（可手动 pt init）"
}

# 把镜像内的 pt 身份同步到宿主 pi-home（幂等、秒级）
# 为什么必须在宿主机做：pt 运行时把 ~/.pentest-agent/pi-home 挂到容器 /root/.pi/agent，
# 会**遮住**镜像里构建期写入的身份；宿主这份若是空的（或首次），agent 就退化成裸 pi。
# 实测踩过：宿主 AGENTS.md 0 字节 + skills/agents 空目录 → agent 自称"pi 编码智能体"。
sync_identity(){
  local dest="$PI_HOME" force="${1:-}"
  local need=0
  [ -s "$dest/AGENTS.md" ] || need=1
  [ "$(ls -1 "$dest/skills" 2>/dev/null | wc -l)" -ge 5 ] || need=1
  [ "$(ls -1 "$dest/agents" 2>/dev/null | wc -l)" -ge 3 ] || need=1
  if [ "$need" = "0" ] && [ "$force" != "force" ]; then return 0; fi
  docker image inspect "$IMAGE" >/dev/null 2>&1 || { warn "镜像不存在，无法同步身份：$IMAGE"; return 1; }
  log "同步身份包：镜像 → $dest（一次性，秒级）"
  local cid; cid="$(docker create "$IMAGE")" || return 1
  mkdir -p "$dest"
  for item in AGENTS.md skills agents; do
    docker rm -f "$cid" >/dev/null 2>&1
    cid="$(docker create "$IMAGE")"
    docker cp "$cid:/root/.pi/agent/$item" "$dest/" >/dev/null 2>&1 || warn "  缺失：$item"
  done
  # 扩展（roe-gate 闸门 + subagent 配置）只补缺，不覆盖宿主已有扩展
  mkdir -p "$dest/extensions"
  docker cp "$cid:/root/.pi/agent/extensions/roe-gate.ts" "$dest/extensions/" >/dev/null 2>&1 || true
  mkdir -p "$dest/extensions/subagent"
  docker cp "$cid:/root/.pi/agent/extensions/subagent/config.json" "$dest/extensions/subagent/" >/dev/null 2>&1 || true
  docker rm -f "$cid" >/dev/null 2>&1 || true
  ok "身份已就绪（技能 $(ls -1 "$dest/skills" 2>/dev/null | wc -l) · 子智能体 $(ls -1 "$dest/agents" 2>/dev/null | wc -l) · AGENTS.md $(stat -c%s "$dest/AGENTS.md" 2>/dev/null || echo 0) 字节）"
}

pick_engagement(){
  mkdir -p "$WS_ROOT"
  if [ -n "${PT_ENG:-}" ]; then ENG="$PT_ENG"; else
    # 只认「像交战」的目录：含 00-简报.md 或 findings.jsonl（避免把杂目录/残留当成交战）
    mapfile -t dirs < <(cd "$WS_ROOT" 2>/dev/null && for d in */; do
        d="${d%/}"
        [ -f "$d/00-简报.md" ] || [ -f "$d/findings.jsonl" ] || continue
        printf '%s\n' "$d"
      done)
    if [ "${#dirs[@]}" -eq 1 ]; then ENG="${dirs[0]}"
    elif [ "${#dirs[@]}" -eq 0 ]; then
      tries=0
      while :; do
        if [ -t 0 ]; then read -rp "交战名（如 acme-2026q4）: " name || name=""; else read -r name || name=""; fi
        if [ -n "${name:-}" ]; then break; fi
        tries=$((tries+1))
        if [ ! -t 0 ] || [ "$tries" -ge 3 ]; then
          die "必须给交战起名（非交互环境请设 PT_ENG=<名字>，例如 PT_ENG=acme-2026q4 pt）"
        fi
        warn "名字不能为空，请再输一次（例如 acme-2026q4）"
      done
      ENG="$(slug "$name")"
    else
      echo "选择交战:"; select d in "${dirs[@]}"; do ENG="$d"; break; done
    fi
  fi
  ENG="$(slug "$ENG")"
  # 关键防护：ENG 解析为空会把骨架直接写进 workspaces/ 根目录（实测踩过），必须拦住
  [ -n "$ENG" ] || die "交战名无效（得到空名）——请用 PT_ENG=<名字> 指定"
  WS="$WS_ROOT/$ENG"; mkdir -p "$WS"/{01-资产,02-证据,03-笔记,04-报告,chains,secrets,audit}
  chmod 700 "$WS/secrets"
  [ -f "$WS/00-简报.md" ] || cat > "$WS/00-简报.md" <<EOF
# $ENG

- 授权方：
- 时间窗：
- 范围（域名/IP/URL）：
- 排除项：
- 联系人：
- 备注：
EOF
  [ -f "$WS/findings.jsonl" ] || : > "$WS/findings.jsonl"
}

container_name(){ printf 'pt-%s' "$1"; }

docker_args(){
  local ws="$1"
  printf '%s\n' \
    --rm -it \
    --name "$(container_name "$ENG")" \
    --hostname "pt-$ENG" \
    --workdir /work \
    -v "$ws:/work" \
    -v "$PI_HOME:/root/.pi/agent" \
    --env-file "$CONFIG" \
    -e "PT_ENG=$ENG" \
    -e "TZ=${TZ:-Asia/Shanghai}" \
    --memory "$MEM" --cpus "$CPUS" --pids-limit "$PIDS"
  # 能力：CAPS 是逗号分隔（如 NET_RAW,NET_ADMIN）→ docker 需要**逐个** --cap-add
  # （曾整串传入导致 `invalid CapAdd: unknown capability: "CAP_NET_RAW,CAP_NET_ADMIN"`）
  capargs=()
  for cap in ${CAPS//,/ }; do
    cap="${cap#"${cap%%[![:space:]]*}"}"; cap="${cap%"${cap##*[![:space:]]}"}"   # trim
    cap="${cap#CAP_}"
    [ -n "$cap" ] && capargs+=(--cap-add "$cap")
  done
  if [ "$NETWORK" = "host" ]; then
    printf '%s\n' "${capargs[@]}"
  else
    printf '%s\n' --network pt-net "${capargs[@]}"
  fi
  [ -n "${HTTP_PROXY:-}" ] && printf '%s\n' -e "HTTP_PROXY=$HTTP_PROXY" -e "HTTPS_PROXY=${HTTPS_PROXY:-$HTTP_PROXY}"
  [ -n "${NO_PROXY:-}" ]   && printf '%s\n' -e "NO_PROXY=$NO_PROXY"
}

cmd_run(){
  need_docker; sync_identity; ensure_models_json; pick_engagement
  local cname; cname="$(container_name "$ENG")"
  if docker ps --format '{{.Names}}' | grep -qx "$cname"; then
    log "接入已运行的交战容器 $cname"
    shift || true
    docker exec -it -w /work "$cname" pi "$@"
  else
    log "启动交战容器 $cname（$IMAGE）· 网络 $NETWORK · ${MEM}/${CPUS}cpu"
    # shellcheck disable=SC2046
    docker run $(docker_args "$WS") "$IMAGE" "$@"
  fi
}

cmd_init(){
  need_docker
  log "模型配置向导"
  echo "  1) DeepSeek 直连（默认）"
  echo "  2) Anthropic / OpenAI / 其他原生 provider"
  echo "  3) 自建 OpenAI 兼容网关"
  read -rp "选择 [1-3，默认 1]: " c; c="${c:-1}"
  case "$c" in
    1) read -rsp "DEEPSEEK_API_KEY: " k; echo
       sed -i '/^#\? *DEEPSEEK_API_KEY=/d' "$CONFIG"; echo "DEEPSEEK_API_KEY=$k" >> "$CONFIG";;
    2) read -rp "provider 名（anthropic/openai/...）: " p; read -rsp "API KEY: " k; echo
       sed -i '/^#\? *PT_PROVIDER=/d' "$CONFIG"; echo "PT_PROVIDER=$p" >> "$CONFIG"
       echo "${p^^}_API_KEY=$k" >> "$CONFIG";;
    3) # baseURL 规范化：允许只填主机名或带尾斜杠，自动补 /v1
       read -rp "网关 baseURL（…/v1；默认 ${PT_BASE_URL:-http://127.0.0.1:8000/v1}）: " u
       u="${u:-${PT_BASE_URL:-}}"
       u="${u%/}"
       case "$u" in */v1) ;; *) u="$u/v1" ;; esac
       read -rsp "网关 API KEY（回车保留原值）: " k; echo
       [ -n "$k" ] || k="${PT_API_KEY:-}"
       [ -n "$k" ] || die "API KEY 不能为空"
       sed -i '/^#\? *PT_PROVIDER=\|^#\? *PT_BASE_URL=\|^#\? *PT_API_KEY=/d' "$CONFIG"
       { echo "PT_PROVIDER=gateway"; echo "PT_BASE_URL=$u"; echo "PT_API_KEY=$k"; } >> "$CONFIG";;
  esac
  read -rp "默认模型 [默认 ${PT_MODEL:-deepseek-v4-flash}]: " m
  if [ -n "$m" ]; then sed -i "s|^PT_MODEL=.*|PT_MODEL=$m|" "$CONFIG"; else sed -i "s|^PT_MODEL=.*|PT_MODEL=${PT_MODEL:-deepseek-v4-flash}|" "$CONFIG"; fi
  chmod 600 "$CONFIG"
  ok "已写入 $CONFIG"

  # ── 关键：pi 只从 ~/.pi/agent/models.json 解析 provider/model ──────────────
  # （pi v0.85 没有 --base-url/--api-key 这些开关；早前自检用它们 → 必然假失败）
  if [ "${PT_PROVIDER:-gateway}" = "gateway" ] && [ -n "${PT_BASE_URL:-}" ]; then
    log "同步模型清单到 pi-home/models.json"
    sync_gateway_models || warn "模型清单同步失败（可手动编辑 $PI_HOME/models.json）"
  fi

  log "连通性自检（容器内 pi 发一次最小请求）"
  local out rc
  out="$(docker run --rm -v "$PI_HOME:/root/.pi/agent" --env-file "$CONFIG" "$IMAGE" \
        pi -p --model "${PT_MODEL:-deepseek-v4-flash}" "Reply with exactly: OK" 2>&1)"; rc=$?
  # 判定：退出码 0 + 有非空回复 + 无错误字样（模型可能回中文"好的"，不能只认 OK）
  if [ "$rc" = "0" ] && [ -n "$out" ] && ! printf '%s' "$out" | grep -qiE "not found|Unknown option|No API key|^Error"; then
    ok "模型连通（${PT_MODEL:-deepseek-v4-flash}）"
  else
    warn "自检失败（退出码 $rc）。最后几行："
    printf '%s\n' "$out" | tail -6 | sed 's/^/     /'
    echo "     排查：① 密钥是否正确 ② baseURL 是否以 /v1 结尾 ③ 模型名是否在清单里（pt models 可刷新）"
  fi
}

# 从网关联表 /v1/models 生成 pi 的 models.json（保留其它 provider；先备份）
sync_gateway_models(){
  local base="${PT_BASE_URL%/}" key="${PT_API_KEY:-}" tmp ids
  tmp="$(mktemp)"
  ids="$(curl -sS -m 15 -H "Authorization: Bearer ${key}" "${base}/models" 2>/dev/null \
        | python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
print("\n".join(m.get("id","") for m in (d.get("data") or d.get("models") or []) if m.get("id")))' 2>/dev/null)" || true
  [ -n "$ids" ] || { warn "网关未返回模型清单（${base}/models）"; return 1; }
  PT_IDS="$ids" PT_BASE="$base" PT_KEY="$key" PI_JSON="$PI_HOME/models.json" python3 - <<'PYEOF'
import json, os, pathlib
ids = [x for x in os.environ["PT_IDS"].splitlines() if x.strip()]
path = pathlib.Path(os.environ["PI_JSON"])
old = json.loads(path.read_text()) if path.is_file() else {"providers": {}}
if path.is_file():
    pathlib.Path(str(path) + ".bak").write_text(json.dumps(old, ensure_ascii=False, indent=1))
cw = int(os.environ.get("PT_CONTEXT_WINDOW", "262144"))
think = {"off": None, "minimal": None, "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"}
old_models = {m.get("id"): m for m in old.get("providers", {}).get("gateway", {}).get("models", [])}
models = []
for i in ids:
    m = dict(old_models.get(i) or {"id": i, "name": i, "contextWindow": cw, "reasoning": True})
    m.setdefault("thinkingLevelMap", think)
    models.append(m)
# 注意字段名：pi 读的是 "api"（不是 "type"）——写错会报
#   Provider "gateway": ... no "api" specified  → 模型全部不可见（实测踩过）
old.setdefault("providers", {})["gateway"] = {
    "baseUrl": os.environ["PT_BASE"],
    "apiKey": os.environ["PT_KEY"],
    "api": "openai-completions",
    "models": models,
}
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(old, ensure_ascii=False, indent=1))
path.chmod(0o600)
print(f"[pt] models.json: gateway {len(models)} 个模型（{', '.join(ids[:4])}…）")
PYEOF
}
cmd_doctor(){
  need_docker; sync_identity || true; ensure_models_json || true; local bad=0
  chk(){ local n="$1"; shift; if "$@" >/dev/null 2>&1; then ok "$n"; else warn "$n 失败"; bad=$((bad+1)); fi; }
  chk "docker daemon" docker info
  chk "镜像 $IMAGE" docker image inspect "$IMAGE"
  chk "config.env 权限 600" bash -c "[ \"\$(stat -c %a '$CONFIG')\" = 600 ]"
  chk "pi 运行时" docker run --rm --env-file "$CONFIG" "$IMAGE" pi --version
  # 身份要查"内容"而不是"存在"（曾出现宿主空文件假通过）
  chk "身份 AGENTS.md（非空）" docker run --rm --entrypoint bash -v "$PI_HOME:/root/.pi/agent" "$IMAGE" -c "test -s /root/.pi/agent/AGENTS.md"
  chk "身份 技能 ≥5" docker run --rm --entrypoint bash -v "$PI_HOME:/root/.pi/agent" "$IMAGE" -c "[ \$(ls -1 /root/.pi/agent/skills 2>/dev/null | wc -l) -ge 5 ]"
  chk "身份 子智能体 ≥3" docker run --rm --entrypoint bash -v "$PI_HOME:/root/.pi/agent" "$IMAGE" -c "[ \$(ls -1 /root/.pi/agent/agents 2>/dev/null | wc -l) -ge 3 ]"
  chk "工具链（nmap/httpx/ffuf）" docker run --rm --entrypoint bash --env-file "$CONFIG" "$IMAGE" \
      -c 'command -v nmap httpx ffuf sqlmap agent-browser >/dev/null'
  chk "字典包" docker run --rm --entrypoint bash --env-file "$CONFIG" "$IMAGE" -c "test -f /opt/pt/dicts/pt-dir-common.txt"
  chk "工作区可写" bash -c "mkdir -p '$WS_ROOT' && touch '$WS_ROOT/.doctor' && rm -f '$WS_ROOT/.doctor'"
  if [ "$bad" -eq 0 ]; then ok "全部通过"; else warn "$bad 项异常"; fi
}

cmd_update(){
  sync_identity force
  need_docker
  log "拉取最新镜像"
  docker pull "${PT_IMAGE_REGISTRY:-ghcr.io/xxxe88}/pt-agent:${PT_UPDATE_VERSION:-latest}" || warn "镜像更新失败（可继续）"
  log "容器内更新身份包与扩展"
  docker run --rm --entrypoint bash --env-file "$CONFIG" -v "$PI_HOME:/root/.pi/agent" "$IMAGE" \
    -c 'pi update --extensions || true'
  ok "更新完成（镜像 tag 可用 PT_IMAGE 指定）"
}

cmd_down(){ need_docker; pick_engagement
  docker rm -f "$(container_name "$ENG")" >/dev/null 2>&1 && ok "容器已删除（工作区保留：$WS）" || log "容器未在运行"; }

cmd_clean(){ need_docker; pick_engagement
  warn "将删除整个工作区：$WS"
  read -rp "输入交战名确认删除: " c; [ "$c" = "$ENG" ] || die "已取消"
  docker rm -f "$(container_name "$ENG")" >/dev/null 2>&1 || true
  rm -rf "$WS"; ok "工作区已删除" ; }

cmd_capture(){ need_docker; pick_engagement
  case "${1:-}" in
    on)  log "在容器内启动 mitmproxy 存档（写入 /work/02-证据/_flows）"
         docker run -d --name "$(container_name "$ENG")-mitm" --network host \
           --entrypoint bash -v "$WS:/work" "$IMAGE" \
           -c 'mkdir -p /work/02-证据/_flows && mitmdump -q -w /work/02-证据/_flows/flow-$(date +%s).flows' >/dev/null
         ok "已开启";;
    off) docker rm -f "$(container_name "$ENG")-mitm" >/dev/null 2>&1 && ok "已关闭" || true;;
    *) die "用法: pt capture on|off";;
  esac; }

cmd_install(){ need_docker; pick_engagement
  [ $# -ge 1 ] || die "用法: pt install <pkg>"
  docker run --rm --entrypoint bash -v "$WS:/work" "$IMAGE" \
    -c "mkdir -p /work/.toolbox/bin && uv pip install --target /work/.toolbox/py '$1' || pip3 install --target /work/.toolbox/py '$1'"
  ok "已装到工作区工具箱（容器内 PATH 已前置 /work/.toolbox/bin）"; }

cmd_snapshot(){ need_docker; pick_engagement
  [ $# -ge 1 ] || die "用法: pt snapshot <tag>"
  docker commit "$(container_name "$ENG")" "$1" >/dev/null && ok "已提交为镜像 $1"; }

cmd_fixperms(){ pick_engagement
  docker run --rm --entrypoint chown -v "$WS_ROOT:/ws" "$IMAGE" -R "${UID:-1000}:${GID:-1000}" "/ws/$ENG" 2>/dev/null \
    && ok "属主已改为 ${UID:-1000}:${GID:-1000}" || warn "修正失败（容器未运行时会跳过）"; }

cmd_export_learnings(){ pick_engagement
  local out="$WS/04-报告/learnings-$(date +%Y%m%d).md"
  log "从 kb-local 与复盘生成脱敏经验导出 → $out"
  docker run --rm --entrypoint bash -v "$WS:/work" -v "$PI_HOME:/root/.pi/agent" "$IMAGE" -c '
    set -e
    out="/work/04-报告/learnings-$(date +%Y%m%d).md"
    { echo "# 本地经验导出（脱敏）"; echo; echo "生成时间: $(date -Iseconds)"; echo
      echo "## 本地经验层"; for f in /root/.pi/agent/skills/kb-local/*.md; do [ -f "$f" ] && { echo "### $(basename "$f")"; cat "$f"; echo; }; done
      echo "## 复盘"; for f in /work/04-报告/复盘.md; do [ -f "$f" ] && cat "$f"; done
    } > "$out"
    sed -i -E "s/((password|passwd|secret|token|api[_-]?key|AK|SK)[\"'\''=: ]+)[^ \"'\'']+/\1***/Ig" "$out" || true
    wc -l "$out"' && ok "已导出（请人工复核脱敏效果）"; }

cmd_selftest(){ need_docker
  if [ -f "$(dirname "$0")/../ranges/selftest.sh" ]; then
    bash "$(dirname "$0")/../ranges/selftest.sh" "$@"
  else
    warn "靶场自检脚本尚未就绪（M3 交付）：ranges/selftest.sh"
  fi; }

case "${1:-}" in
  "") cmd_run ;;
  init) shift; cmd_init ;;
  doctor) shift; cmd_doctor ;;
  update) shift; cmd_update ;;
  down) shift; cmd_down ;;
  clean) shift; cmd_clean ;;
  capture) shift; cmd_capture "$@" ;;
  install) shift; cmd_install "$@" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  fix-perms) shift; cmd_fixperms ;;
  export-learnings) shift; cmd_export_learnings ;;
  selftest) shift; cmd_selftest "$@" ;;
  mcp) shift
    case "${1:-}" in
      ""|list) echo "v1 默认零 MCP（白名单为空）。可用：pt mcp add <name> -- <command> [args...]"; 
               echo "内置模板：fofa / shodan / searxng（需自备 key）";;
      add)
        shift
        case "${1:-}" in
          fofa|shodan|searxng) die "模板已预留但未随 v1 发布（需自备 key 与合规确认）：$1";;
          *) shift 2>/dev/null || true
             die "自定义 MCP 需编辑 $PT_HOME/pi-home/mcp.json 后重启容器（v1 不做自动写配置）";;
        esac;;
      *) die "用法：pt mcp [list|add]";;
    esac ;;
  resume) shift; cmd_run --continue ;;
  run) shift; cmd_run "$@" ;;
  help|-h|--help) sed -n '2,20p' "$0";;
  *) cmd_run "$@" ;;
esac
